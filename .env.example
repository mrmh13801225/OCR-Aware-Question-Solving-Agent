# --- OCR ---
OCR_PROVIDER=datalab            # nanonets | datalab | local_vlm | fake
NANONETS_API_KEY=
DATALAB_API_KEY=
LOCAL_VLM_BASE_URL=http://localhost:8000/v1   # vLLM/Ollama OpenAI-compatible endpoint
LOCAL_VLM_MODEL=qwen2.5-vl-7b-instruct
LOCAL_VLM_API_KEY=                            # only for gated local servers (vLLM --api-key, LM Studio)

# --- Reasoning (solve/correct) ---
REASONING_PROVIDER=openai_compatible        # claude | openai_compatible | fake
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- App ---
PYTHONUTF8=1                     # Windows consoles default to cp1252, which cannot encode Persian output
RETRY_CAP=2                      # corrections allowed (solve attempts = cap + 1)
ANSWER_MAPPING=trust_model       # trust_model | labels_then_position
SOLVE_MODE=image_grounded        # image_grounded: solve sees image + OCR text | text_only: solve sees OCR text alone (image still sent for corrections)
NOISE_RATE=0.05                  # character-level perturbation rate for the noise injector
NOISE_SEED=42                    # deterministic corruption seed for inject_noise
RESULTS_DIR=./results
LOG_LEVEL=INFO                   # INFO logs the audit trail (original OCR, prompts, responses, corrections); WARNING quiets it
LOG_FILE=                        # optional: append the same trail to this file instead of stderr
